# .data/icon.svg

echo '[Desktop Entry]
Name=Uni
Icon=uni
Exec=uni
StartupNotify=true
Type=Application
Categories=Development;
' > /usr/share/applications/uni.Uni.desktop

echo '[Desktop Entry]
Name=UniLock
Exec=uni lock
StartupNotify=true
Type=Application
NoDisplay=true
' > /usr/share/applications/uni.UniLock.desktop

